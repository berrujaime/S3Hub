{
  "expo": {
    "name": "S3Hub",
    "slug": "S3Hub",
    "version": "1.3.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7FA"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#0E1116"
      },
      "package": "com.BerruApps.S3Hub",
      "allowBackup": false,
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#F5F7FA",
        "dark": {
          "image": "./assets/splash-dark.png",
          "backgroundColor": "#0E1116"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugin/with16KPageSize",
      "./plugin/withAndroidPageSize",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "85a3d172-215c-4058-b009-7d104bbe58ba"
      },
      "privacyPolicyUrl": "https://berrujaime.github.io/S3Hub/privacy.html"
    }
  }
}
